+/**
+ * Envia Push Notification (FCM) para o cliente quando o pedido for entregue ou estiver pronto.
+ */
+exports.notificaStatusPedido = onDocumentUpdated('orders/{orderId}', async (event) => {
+  const newValue = event.data.after.data();
+  const previousValue = event.data.before.data();
+  
+  if (!newValue || !previousValue) return null;
+  
+  // Só notifica se o status mudou para 'pronto' ou 'entregue'
+  if (newValue.status === previousValue.status) return null;
+  if (!['pronto', 'entregue'].includes(newValue.status)) return null;
+
+  const clienteUid = newValue.clienteUid;
+  if (!clienteUid) return null;
+
+  const userSnap = await db.collection('clientes').doc(clienteUid).get();
+  const token = userSnap.data()?.fcmToken;
+  
+  if (!token) return null;
+  
+  const titulos = { pronto: 'Seu pedido está pronto!', entregue: 'Pedido Entregue!' };
+  const corpos = { pronto: 'Venha retirar seu burguer 🍔', entregue: 'Aproveite seu burguer e nos avalie 🍔' };
+  
+  try {
+    await messaging.send({ token, notification: { title: titulos[newValue.status], body: corpos[newValue.status] }});
+  } catch (err) { logger.error('Erro ao enviar push notification:', err); }
+});
