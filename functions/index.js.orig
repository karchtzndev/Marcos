// Back-end do Pix automático — O Markin
// --------------------------------------
// Duas functions:
//   criarPagamentoPix  — o site do cliente chama depois de criar o pedido.
//                        Gera a cobrança no Mercado Pago e devolve o QR Code.
//   webhookMercadoPago — o Mercado Pago chama quando o pagamento muda de
//                        status. Confirma o pagamento e marca o pedido como pago.
//
// NADA disso roda sozinho: precisa do módulo "Pix automático" ligado no
// painel (aba Módulos) E das credenciais do Mercado Pago configuradas como
// secret (veja o README na raiz do projeto, seção "Ativando o Pix automático").

const { onCall, onRequest, HttpsError } = require('firebase-functions/v2/https');
const { defineSecret } = require('firebase-functions/params');
const logger = require('firebase-functions/logger');
const admin = require('firebase-admin');
const crypto = require('crypto');

admin.initializeApp();
const db = admin.firestore();

const MP_ACCESS_TOKEN = defineSecret('MP_ACCESS_TOKEN');
const MP_WEBHOOK_SECRET = defineSecret('MP_WEBHOOK_SECRET');

const MP_API = 'https://api.mercadopago.com';
const EXPIRACAO_MINUTOS = 30;

async function mercadoPagoFetch(caminho, token, opcoes = {}){
  const resp = await fetch(MP_API + caminho, {
    ...opcoes,
    headers: {
      'Authorization': `Bearer ${token}`,
      'Content-Type': 'application/json',
      ...(opcoes.headers || {})
    }
  });
  const corpo = await resp.json().catch(() => ({}));
  if(!resp.ok){
    logger.error('Mercado Pago respondeu com erro', { status: resp.status, corpo });
    throw new Error(`Mercado Pago: ${resp.status} — ${corpo.message || 'erro desconhecido'}`);
  }
  return corpo;
}

// E-mail sintético a partir do telefone: o checkout do site não coleta
// e-mail do cliente, e a API do Mercado Pago exige um payer.email pra criar
// a cobrança Pix. Não é usado pra enviar nada — só precisa parecer um e-mail.
function emailSintetico(telefone){
  const digitos = String(telefone || '').replace(/\D/g, '') || 'cliente';
  return `${digitos}@pix.omarkinburguer.com.br`;
}

/**
 * Chamada pelo site do cliente (httpsCallable) logo depois de criar o
 * pedido, quando a forma de pagamento escolhida é Pix e o módulo está ligado.
 */
exports.criarPagamentoPix = onCall({ secrets: [MP_ACCESS_TOKEN] }, async (request) => {
  const orderCode = String(request.data?.orderCode || '').trim();
  if(!orderCode){
    throw new HttpsError('invalid-argument', 'orderCode é obrigatório.');
  }

  const featuresSnap = await db.collection('store').doc('features').get();
  if(featuresSnap.data()?.pixAutomatico !== true){
    throw new HttpsError('failed-precondition', 'Pix automático está desligado no painel.');
  }

  const orderRef = db.collection('orders').doc(orderCode);
  const orderSnap = await orderRef.get();
  if(!orderSnap.exists){
    throw new HttpsError('not-found', 'Pedido não encontrado.');
  }
  const order = orderSnap.data();

  if(order.paid === true){
    throw new HttpsError('failed-precondition', 'Este pedido já está pago.');
  }

  // Cobrança ainda válida? Reaproveita em vez de gerar uma nova (evita
  // cobranças duplicadas se o cliente atualizar a página).
  if(order.pix?.qrCodeBase64 && order.pix?.expiraEm && new Date(order.pix.expiraEm) > new Date()){
    return {
      qrCode: order.pix.qrCode,
      qrCodeBase64: order.pix.qrCodeBase64,
      expiraEm: order.pix.expiraEm
    };
  }

  const total = Number(order.total);
  if(!(total > 0)){
    throw new HttpsError('failed-precondition', 'Pedido sem valor válido.');
  }

  const expiraEm = new Date(Date.now() + EXPIRACAO_MINUTOS * 60 * 1000);

  const pagamento = await mercadoPagoFetch('/v1/payments', MP_ACCESS_TOKEN.value(), {
    method: 'POST',
    // Evita criar duas cobranças pro mesmo pedido se a chamada for repetida
    // (ex: cliente atualizou a página no meio do carregamento).
    headers: { 'X-Idempotency-Key': orderCode },
    body: JSON.stringify({
      transaction_amount: total,
      description: `Pedido ${orderCode} — O Markin Chef's Burguer`,
      payment_method_id: 'pix',
      external_reference: orderCode,
      date_of_expiration: expiraEm.toISOString(),
      payer: {
        email: emailSintetico(order.phone),
        first_name: (order.customerName || 'Cliente').split(' ')[0]
      }
    })
  });

  const dadosPix = pagamento.point_of_interaction?.transaction_data;
  if(!dadosPix?.qr_code_base64){
    logger.error('Resposta do Mercado Pago sem QR Code', pagamento);
    throw new HttpsError('internal', 'Não foi possível gerar o QR Code Pix.');
  }

  const registro = {
    mpPaymentId: pagamento.id,
    qrCode: dadosPix.qr_code,
    qrCodeBase64: dadosPix.qr_code_base64,
    criadoEm: new Date().toISOString(),
    expiraEm: expiraEm.toISOString()
  };
  await orderRef.update({ pix: registro });

  return { qrCode: registro.qrCode, qrCodeBase64: registro.qrCodeBase64, expiraEm: registro.expiraEm };
});

/**
 * URL de webhook a cadastrar no painel do Mercado Pago
 * (Suas integrações → aplicação → Webhooks). O Mercado Pago manda só o ID
 * do pagamento — a gente sempre rebusca os dados direto na API deles antes
 * de confiar em qualquer coisa, nunca no corpo do webhook em si (ele pode
 * ser forjado por quem souber a URL).
 */
exports.webhookMercadoPago = onRequest({ secrets: [MP_ACCESS_TOKEN, MP_WEBHOOK_SECRET] }, async (req, res) => {
  try{
    if(!validarAssinatura(req, MP_WEBHOOK_SECRET.value())){
      logger.warn('Webhook do Mercado Pago com assinatura inválida — ignorado.');
      res.status(401).send('assinatura inválida');
      return;
    }

    const paymentId = req.body?.data?.id || req.query['data.id'] || req.query.id;
    const tipo = req.body?.type || req.query.type || req.query.topic;
    if(tipo !== 'payment' || !paymentId){
      // Mercado Pago manda outros tipos de evento (ex: merchant_order) que
      // não interessam aqui — responde 200 pra ele não ficar reenviando.
      res.status(200).send('ignorado');
      return;
    }

    const pagamento = await mercadoPagoFetch(`/v1/payments/${paymentId}`, MP_ACCESS_TOKEN.value());
    const orderCode = pagamento.external_reference;
    if(!orderCode){
      logger.warn('Pagamento sem external_reference', { paymentId });
      res.status(200).send('sem referência');
      return;
    }

    if(pagamento.status === 'approved'){
      await db.collection('orders').doc(orderCode).update({
        paid: true,
        paidAt: new Date().toISOString(),
        paidTotal: pagamento.transaction_amount,
        paymentMethods: ['pix'],
        'pix.mpStatus': pagamento.status
      });
      logger.info(`Pedido ${orderCode} pago via Pix.`);
    }else{
      await db.collection('orders').doc(orderCode)
        .update({ 'pix.mpStatus': pagamento.status })
        .catch(() => {});
    }

    res.status(200).send('ok');
  }catch(e){
    logger.error('Erro no webhook do Mercado Pago', e);
    // 200 mesmo em erro interno: um 4xx/5xx faz o Mercado Pago ficar
    // reenviando o mesmo evento várias vezes. O erro já foi logado acima.
    res.status(200).send('erro registrado');
  }
});

// Valida a assinatura do webhook conforme a documentação do Mercado Pago
// (header x-signature, formato "ts=...,v1=...", HMAC-SHA256 do manifesto
// "id:{data.id};request-id:{x-request-id};ts:{ts};" usando o Webhook Secret).
// IMPORTANTE: confirme esse formato contra a documentação atual do Mercado
// Pago (Suas integrações → Webhooks → "Assinatura secreta") na hora de
// ativar de verdade — é a parte mais provável de mudar entre a escrita
// deste código e o dia da ativação.
function validarAssinatura(req, secret){
  if(!secret) return false;
  const assinatura = req.get('x-signature');
  const requestId = req.get('x-request-id');
  if(!assinatura) return false;

  const partes = Object.fromEntries(
    assinatura.split(',').map(p => p.trim().split('=').map(s => s.trim()))
  );
  const ts = partes.ts;
  const v1 = partes.v1;
  if(!ts || !v1) return false;

  const dataId = req.body?.data?.id || req.query['data.id'] || req.query.id || '';
  const manifesto = `id:${dataId};request-id:${requestId};ts:${ts};`;
  const esperado = crypto.createHmac('sha256', secret).update(manifesto).digest('hex');

  try{
    return crypto.timingSafeEqual(Buffer.from(v1), Buffer.from(esperado));
  }catch(e){
    return false; // tamanhos diferentes = já não bate
  }
}
